  67, 9103, VIRTKEY, CONTROL
  86, 9104, VIRTKEY, CONTROL
  70, 9106, VIRTKEY, CONTROL
  72, 9108, VIRTKEY, CONTROL
  71, 9109, VIRTKEY, CONTROL
  65, 9110, VIRTKEY, CONTROL
  114, 9107, VIRTKEY
  116, 9111, VIRTKEY
  46, 9105, VIRTKEY
